# Bhoomi Sanket Environment Variables Template

ADMIN_EMAIL=admin@bhoomisanket.gov.in
ADMIN_PASSWORD=CHANGE_ME

AUTH_SECRET=CHANGE_ME

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_CHANGE_ME
CLERK_SECRET_KEY=sk_test_CHANGE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ML Service
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_SECRET=CHANGE_ME
ML_SERVICE_TIMEOUT_MS=5000
ML_SERVICE_RETRIES=2

INTERNAL_API_SECRET=CHANGE_ME

PYTHON_SERVICE_HOST=127.0.0.1
PYTHON_SERVICE_PORT=8000
PYTHON_SERVICE_RETRIES=2
PYTHON_SERVICE_TIMEOUT_MS=5000

# Supabase / Prisma
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"